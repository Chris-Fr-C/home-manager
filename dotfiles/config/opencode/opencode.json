{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-lmstudio@latest"
  ],
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "*": {
          "limit": {
            "context": 8192,
            "output": 2048
          }
        }
      }
    }
  },

  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  },


  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  }
}
